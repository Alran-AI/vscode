{
  "name": "alran-vscode",
  "displayName": "Alran Code",
  "description": "Alran Code, the AI coding agent by Ottili, inside VS Code and compatible editors. Runs the real Alran Code harness over the Agent Client Protocol.",
  "version": "0.1.0",
  "publisher": "ottili",
  "license": "MIT",
  "private": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b2a4a",
    "theme": "dark"
  },
  "homepage": "https://api.ottili.one",
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "alran",
    "ottili",
    "ai",
    "agent",
    "acp",
    "coding agent",
    "mcp"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Alran runs an agent that can read files and execute commands."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Alran needs a local file system."
    }
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "alran",
          "title": "Alran Code",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "alran": [
        {
          "type": "webview",
          "id": "alran.chat",
          "name": "Chat",
          "icon": "media/activitybar.svg",
          "contextualTitle": "Alran Code"
        },
        {
          "id": "alran.sessions",
          "name": "Sessions",
          "visibility": "collapsed",
          "icon": "media/activitybar.svg"
        },
        {
          "id": "alran.changes",
          "name": "Changes",
          "visibility": "collapsed",
          "icon": "media/activitybar.svg"
        },
        {
          "id": "alran.agents",
          "name": "Agents",
          "visibility": "collapsed",
          "icon": "media/activitybar.svg"
        },
        {
          "id": "alran.capabilities",
          "name": "Capabilities",
          "visibility": "collapsed",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "alran.sessions",
        "contents": "Previous sessions appear here once the agent is connected.\n[Open Chat](command:alran.openChat)"
      },
      {
        "view": "alran.changes",
        "contents": "Files this session changes appear here."
      },
      {
        "view": "alran.agents",
        "contents": "Sub-agents started by this session appear here."
      }
    ],
    "commands": [
      {
        "command": "alran.openChat",
        "title": "Open Chat",
        "category": "Alran",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "alran.openInEditor",
        "title": "Open Chat in Editor",
        "category": "Alran",
        "icon": "$(empty-window)"
      },
      {
        "command": "alran.newSession",
        "title": "New Session",
        "category": "Alran",
        "icon": "$(add)"
      },
      {
        "command": "alran.resumeSession",
        "title": "Resume Session…",
        "category": "Alran",
        "icon": "$(history)"
      },
      {
        "command": "alran.openSession",
        "title": "Open Session",
        "category": "Alran"
      },
      {
        "command": "alran.forkSession",
        "title": "Fork Session",
        "category": "Alran",
        "icon": "$(repo-forked)"
      },
      {
        "command": "alran.closeSession",
        "title": "Close Session Tab",
        "category": "Alran",
        "icon": "$(close)"
      },
      {
        "command": "alran.refreshSessions",
        "title": "Refresh Sessions",
        "category": "Alran",
        "icon": "$(refresh)"
      },
      {
        "command": "alran.sideQuestion",
        "title": "Ask a Side Question (/btw)…",
        "category": "Alran",
        "icon": "$(comment)"
      },
      {
        "command": "alran.cancel",
        "title": "Stop Running Turn",
        "category": "Alran",
        "icon": "$(debug-stop)"
      },
      {
        "command": "alran.retry",
        "title": "Retry Last Message",
        "category": "Alran",
        "icon": "$(refresh)"
      },
      {
        "command": "alran.compact",
        "title": "Compact Conversation",
        "category": "Alran",
        "icon": "$(fold)"
      },
      {
        "command": "alran.exportSession",
