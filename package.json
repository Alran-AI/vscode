      },
      {
        "command": "alran.clearChanges",
        "title": "Clear Change List",
        "category": "Alran",
        "icon": "$(clear-all)"
      },
      {
        "command": "alran.refreshChanges",
        "title": "Refresh Changes",
        "category": "Alran",
        "icon": "$(refresh)"
      },
      {
        "command": "alran.refreshCapabilities",
        "title": "Refresh",
        "category": "Alran",
        "icon": "$(refresh)"
      },
      {
        "command": "alran.insertSkill",
        "title": "Use Skill",
        "category": "Alran"
      },
      {
        "command": "alran.pluginInstall",
