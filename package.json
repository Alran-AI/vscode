        "icon": "$(plug)"
      },
      {
        "command": "alran.help",
        "title": "Show Help",
        "category": "Alran",
        "icon": "$(question)"
      },
      {
        "command": "alran.changelog",
        "title": "Show Changelog",
        "category": "Alran"
      },
      {
        "command": "alran.openChange",
        "title": "Show File Changes",
        "category": "Alran"
      },
      {
        "command": "alran.revertChange",
