      }
    ],
    "keybindings": [
      {
        "command": "alran.openChat",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "alran.newSession",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "alran.hasSession"
      },
      {
        "command": "alran.addSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "alran.explainSelection",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorHasSelection"
      },
      {
        "command": "alran.cancel",
        "key": "ctrl+alt+backspace",
        "mac": "cmd+alt+backspace",
        "when": "alran.running"
      },
      {
        "command": "alran.pickModel",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      },
      {
        "command": "alran.togglePlanMode",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "alran.insertSkill",
          "when": "false"
        },
        {
          "command": "alran.openChange",
          "when": "false"
        },
        {
          "command": "alran.openSession",
          "when": "false"
        },
        {
          "command": "alran.pluginDisable",
          "when": "false"
        },
        {
          "command": "alran.pluginEnable",
          "when": "false"
        },
        {
          "command": "alran.pluginInstall",
          "when": "false"
        },
        {
          "command": "alran.pluginUninstall",
          "when": "false"
        },
        {
          "command": "alran.providerRemove",
          "when": "false"
        },
        {
          "command": "alran.providerTest",
          "when": "false"
        },
        {
          "command": "alran.revertChange",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "alran.newSession",
          "when": "view == alran.chat",
          "group": "navigation@1"
        },
        {
          "command": "alran.resumeSession",
          "when": "view == alran.chat",
          "group": "navigation@2"
        },
        {
          "command": "alran.openInEditor",
          "when": "view == alran.chat",
          "group": "navigation@3"
        },
        {
          "command": "alran.openSettings",
          "when": "view == alran.chat",
          "group": "1_more"
        },
        {
          "command": "alran.restartAgent",
          "when": "view == alran.chat",
          "group": "1_more"
        },
        {
          "command": "alran.openTui",
          "when": "view == alran.chat",
          "group": "1_more"
        },
        {
          "command": "alran.showLogs",
          "when": "view == alran.chat",
          "group": "1_more"
        },
        {
          "command": "alran.refreshSessions",
          "when": "view == alran.sessions",
          "group": "navigation"
        },
        {
          "command": "alran.revertAllChanges",
          "when": "view == alran.changes",
          "group": "navigation@1"
        },
        {
          "command": "alran.refreshChanges",
          "when": "view == alran.changes",
          "group": "navigation@2"
        },
        {
          "command": "alran.clearChanges",
          "when": "view == alran.changes",
          "group": "navigation@3"
        },
        {
          "command": "alran.agentsStop",
          "when": "view == alran.agents",
          "group": "navigation"
        },
        {
          "command": "alran.refreshCapabilities",
          "when": "view == alran.capabilities",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "alran.forkSession",
          "when": "view == alran.sessions",
          "group": "inline@1"
        },
        {
          "command": "alran.closeSession",
          "when": "view == alran.sessions && viewItem == session.open",
          "group": "inline@2"
        },
        {
          "command": "alran.revertChange",
          "when": "view == alran.changes && viewItem == change",
          "group": "inline"
        },
        {
          "command": "alran.pluginInstall",
          "when": "viewItem == plugin.available",
          "group": "inline"
        },
        {
          "command": "alran.pluginDisable",
          "when": "viewItem == plugin.enabled",
          "group": "inline@1"
        },
        {
          "command": "alran.pluginEnable",
          "when": "viewItem == plugin.disabled",
          "group": "inline@1"
        },
        {
          "command": "alran.pluginUninstall",
          "when": "viewItem =~ /^plugin\\.(enabled|disabled)$/",
          "group": "inline@2"
        },
        {
          "command": "alran.pluginInstallBySelector",
          "when": "viewItem == group.plugins",
          "group": "inline@1"
        },
        {
          "command": "alran.pluginMarketplaceUpgrade",
          "when": "viewItem == group.plugins",
          "group": "inline@2"
        },
        {
          "command": "alran.providerAdd",
          "when": "viewItem == group.providers",
          "group": "inline@1"
        },
        {
          "command": "alran.providerSetKey",
          "when": "viewItem == group.providers",
          "group": "inline@2"
        },
        {
          "command": "alran.providerUseSource",
          "when": "viewItem == group.providers",
          "group": "1_more"
        },
        {
          "command": "alran.providerTest",
          "when": "viewItem =~ /^provider\\./",
          "group": "inline@1"
        },
        {
          "command": "alran.providerRemove",
          "when": "viewItem == provider.editable",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "command": "alran.addSelection",
          "when": "editorHasSelection",
          "group": "9_alran@1"
        },
        {
          "command": "alran.explainSelection",
          "when": "editorHasSelection",
          "group": "9_alran@2"
        },
        {
          "command": "alran.fixSelection",
          "when": "editorHasSelection",
          "group": "9_alran@3"
        },
        {
          "command": "alran.addFile",
          "when": "!editorHasSelection",
          "group": "9_alran@1"
        }
      ],
      "editor/title": [
        {
          "command": "alran.addFile",
          "group": "9_alran",
          "when": "resourceScheme == file"
        }
      ],
      "explorer/context": [
        {
          "command": "alran.addFile",
          "group": "9_alran",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "terminal/context": [
        {
          "command": "alran.addTerminalSelection",
          "group": "9_alran",
          "when": "terminalTextSelected"
        }
      ],
      "scm/title": [
        {
          "command": "alran.reviewChanges",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Alran Code",
      "properties": {
        "alran.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `alran` CLI or its `cli.js`. Leave empty to search `PATH`, the login shell, and standard install locations."
        },
        "alran.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Node.js executable used when alran.executablePath points at a JavaScript file. Alran needs Node 22.19 or newer."
        },
        "alran.env": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "scope": "machine-overridable",
          "markdownDescription": "Extra environment variables for the agent, for example `ALRAN_DATA_DIR`."
        },
        "alran.lane": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Managed backend lane, for test or staging builds only."
        },
        "alran.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Start the agent and open a session as soon as the chat view is shown."
        },
        "alran.systemPrompt": {
          "type": "string",
          "default": "",
          "markdownDescription": "Replaces the identity prompt (`--system-prompt`). Runtime rules, project instructions, Memory, and Skills stay."
        },
        "alran.systemPromptFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "File that replaces the identity prompt (`--system-prompt-file`)."
        },
        "alran.appendSystemPrompt": {
          "type": "string",
          "default": "",
          "markdownDescription": "Text added after the identity prompt (`--append-system-prompt`)."
        },
        "alran.appendSystemPromptFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "File added after the identity prompt (`--append-system-prompt-file`)."
        },
        "alran.mcpServers": {
          "type": "array",
          "default": [],
          "markdownDescription": "MCP servers added to every session from this editor, in ACP format: `{ \"name\", \"command\", \"args\": [], \"env\": [] }` or `{ \"type\": \"http\"|\"sse\", \"name\", \"url\", \"headers\": [] }`.",
          "items": {
            "type": "object"
          }
        },
        "alran.chat.enterWhileRunning": {
          "type": "string",
          "enum": [
            "steer",
            "queue"
          ],
          "default": "steer",
          "enumDescriptions": [
            "Enter delivers the message into the running turn; Ctrl+Enter queues it.",
            "Enter queues the message for after this turn; Ctrl+Enter steers."
          ],
          "description": "What Enter does while a turn is running."
        },
        "alran.chat.sendShortcut": {
          "type": "string",
          "enum": [
            "enter",
            "ctrlEnter"
          ],
          "default": "enter",
          "description": "Key that sends a message. The other combination inserts a new line."
        },
        "alran.chat.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "Show the model's reasoning in the transcript."
        },
        "alran.context.includeActiveFile": {
          "type": "boolean",
          "default": true,
