        "category": "Alran",
        "icon": "$(debug-stop)"
      },
      {
        "command": "alran.addSelection",
        "title": "Add Selection to Chat",
        "category": "Alran",
        "icon": "$(add)"
      },
      {
        "command": "alran.addFile",
        "title": "Add File to Chat",
        "category": "Alran",
        "icon": "$(add)"
      },
      {
        "command": "alran.addTerminalSelection",
