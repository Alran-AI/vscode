        "category": "Alran",
        "icon": "$(book)"
      },
      {
        "command": "alran.copyLastResponse",
        "title": "Copy Last Response",
        "category": "Alran",
        "icon": "$(copy)"
      },
      {
        "command": "alran.pickModel",
