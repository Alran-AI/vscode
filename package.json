        "category": "Alran",
        "icon": "$(lightbulb)"
      },
      {
        "command": "alran.pickPermissionMode",
        "title": "Choose Permission Mode…",
        "category": "Alran",
        "icon": "$(shield)"
      },
      {
        "command": "alran.togglePlanMode",
